DUCKDNS_TOKEN=your-token-here
POSTGRES_ADMIN_PASSWORD=your-secret-pgsql-password
AUTHELIA_POSTGRES_PASSWORD=your-secret-authelia-pgsql-password
VAULTWARDEN_POSTGRES_PASSWORD=your-secret-vaultworden-pgsql-password
IMMICH_POSTGRES_PASSWORD=your-secret-immich-pgsql-password

AUTHELIA_ADMIN_PASSWORD_HASH='your-hashed-with-argon2-password-here'
AUTHELIA_JWT_SECRET=your-jwt-secret-here
AUTHELIA_SESSION_SECRET=your-session-secret-here
AUTHELIA_STORAGE_KEY=your-storage-secret-here
AUTHELIA_HMAC_SECRET=your-hmac-secret-here

# Hashed digest of AUTHELIA_IMMICH_CLIENT_SECRET inserted into Authelia's configuration.yml
AUTHELIA_IMMICH_CLIENT_SECRET_HASH='your-pbkdf2-hashed-client-secret-here'

VAULTWARDEN_ADMIN_TOKEN='your-vaultwarden-argon2-hash-here'


# ==============================================================================
# SECRET GENERATION COMMANDS
# ==============================================================================
#
# 1. AUTHELIA ADMIN PASSWORD HASH (Argon2id):
#    AUTHELIA_ADMIN_PASSWORD_HASH=$(docker run --rm authelia/authelia:4 authelia crypto hash generate argon2 --password 'your-sso-account-password')
#
# 2. VAULTWARDEN ADMIN TOKEN HASH (Argon2id):
#    VAULTWARDEN_ADMIN_TOKEN=$(docker run --rm -it vaultwarden/server:1.37 /vaultwarden hash --password 'YourSecretAdminPassword')
#
# 3. IMMICH OIDC CLIENT SECRET (2-Step Process):
#    Step A — Generate the raw plain secret (Copy to AUTHELIA_IMMICH_CLIENT_SECRET and keep for Immich Web UI):
#      RAW_SECRET=$(openssl rand -hex 32) && echo "Raw Secret: $RAW_SECRET"
#
#    Step B — Hash the raw secret with PBKDF2 for Authelia's configuration.yml:
#      docker run --rm authelia/authelia:4 authelia crypto hash generate pbkdf2 --variant sha512 --password "$RAW_SECRET"
#      (Copy the resulting digest string starting with '$pbkdf2-sha512$' into AUTHELIA_IMMICH_CLIENT_SECRET_HASH)
#
# 4. RANDOM CRYPTOGRAPHIC SECRETS (Forgettable / High Entropy):
#    Run 'openssl rand -hex 32' separately for EACH of the following variables:
#    - DUCKDNS_TOKEN
#    - POSTGRES_ADMIN_PASSWORD
#    - AUTHELIA_POSTGRES_PASSWORD
#    - VAULTWARDEN_POSTGRES_PASSWORD
#    - IMMICH_POSTGRES_PASSWORD
#    - AUTHELIA_JWT_SECRET
#    - AUTHELIA_SESSION_SECRET
#    - AUTHELIA_STORAGE_KEY
#    - AUTHELIA_HMAC_SECRET
#
# ==============================================================================
