server:
  address: 'tcp://0.0.0.0:9091/'

identity_validation:
  reset_password:
    jwt_secret: '{{ lookup("env", "AUTHELIA_JWT_SECRET") }}'

session:
  name: 'authelia_session'
  secret: '{{ lookup("env", "AUTHELIA_SESSION_SECRET") }}'
  expiration: '1h'
  inactivity: '5m'
  cookies:
    - domain: 'rioly-homelab.duckdns.org'
      authelia_url: 'https://auth.rioly-homelab.duckdns.org'

authentication_backend:
  password_reset:
    disable: true
  file:
    path: '/config/users_database.yml'
    password:
      algorithm: argon2id

definitions:
  network:
    lan:
      - '192.168.0.0/16'

access_control:
  default_policy: 'deny'
  rules:
    - domain: 'auth.rioly-homelab.duckdns.org'
      policy: 'bypass'
    - domain: '*.rioly-homelab.duckdns.org'
      networks:
        - 'lan'
      policy: 'one_factor'
    - domain: '*.rioly-homelab.duckdns.org'
      policy: 'two_factor'

regulation:
  max_retries: 3
  find_time: '5m'
  ban_time: '15m'

storage:
  encryption_key: '{{ lookup("env", "AUTHELIA_STORAGE_KEY") }}'
  postgres:
    address: 'tcp://postgres:5432'
    database: 'authelia'
    username: 'authelia'
    password: '{{ lookup("env", "AUTHELIA_POSTGRES_PASSWORD") }}'

notifier:
  filesystem:
    filename: '/config/emails.txt'

identity_providers:
  oidc:
    hmac_secret: '{{ lookup("env", "AUTHELIA_HMAC_SECRET") }}'
    jwks:
      - key_id: 'immich-key'
        algorithm: 'RS256'
        use: 'sig'
        key: |
          {{ lookup("file", "secrets/oidc-private.pem") | indent(10) }}
    clients:
      - client_id: 'immich'
        client_name: 'Immich'
        client_secret: '{{ lookup("env", "AUTHELIA_IMMICH_CLIENT_SECRET_HASH") }}'
        public: false
        authorization_policy: 'two_factor'
        require_pkce: true
        pkce_challenge_method: 'S256'
        redirect_uris:
          - 'https://immich.rioly-homelab.duckdns.org/auth/login'
          - 'https://immich.rioly-homelab.duckdns.org/user-settings'
          - 'app.immich:///oauth-callback'
        scopes:
          - 'openid'
          - 'profile'
          - 'email'
        response_types:
          - 'code'
        grant_types:
          - 'authorization_code'
        access_token_signed_response_alg: 'none'
        userinfo_signed_response_alg: 'none'
        token_endpoint_auth_method: 'client_secret_post'
